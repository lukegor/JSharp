<Window x:Class="JSharp.UI.Views.PlotlineGraphWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
        xmlns:local="clr-namespace:JSharp.UI.Views"
        xmlns:viewModels="clr-namespace:JSharp.ViewModels"
        xmlns:resx="clr-namespace:JSharp.Shared.Resources;assembly=JSharp.Shared"
        d:DataContext="{d:DesignInstance Type=viewModels:PlotlineGraphWindowViewModel}"
        mc:Ignorable="d"
        Title="PlotlineGraphWindow" Height="450" Width="800">
	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>
		<lvc:CartesianChart Grid.Row="0" Series="{Binding Values}" LegendPosition="Hidden" ZoomMode="X"/>
		<Button Grid.Row="1" Content="{x:Static resx:Strings.Export}" Click="Export_Click"
				HorizontalAlignment="Right" Margin="8" Padding="16,4"/>
	</Grid>
</Window>
