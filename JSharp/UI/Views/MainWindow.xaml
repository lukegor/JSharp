<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:JSharp.UI.Views"
        xmlns:prism="http://prismlibrary.com/"
		xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
		xmlns:viewModels="clr-namespace:JSharp.ViewModels"
		xmlns:resx="clr-namespace:JSharp.Shared.Resources;assembly=JSharp.Shared"
		x:Class="JSharp.UI.Views.MainWindow"
		d:DataContext="{d:DesignInstance Type=viewModels:MainWindowViewModel}"
		mc:Ignorable="d"
        Title="JSharp" Height="180" Width="700" ResizeMode="CanMinimize" Closing="Window_Closing" PreviewKeyDown="Window_PreviewKeyDown">

	<Window.Resources>
		<BooleanToVisibilityConverter x:Key="BoolToVis"/>
	</Window.Resources>

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>
		<Menu Width="Auto" Height="20" VerticalAlignment="Top" Grid.Row="0">
			<MenuItem Header="{x:Static resx:UIStrings.File}">
				<MenuItem x:Name="Open" Header="{x:Static resx:Strings.Open}">
					<MenuItem Header="{x:Static resx:Strings.OpenGray}" Command="{Binding OpenGray_ClickCommand}"/>
					<MenuItem Header="{x:Static resx:Strings.OpenRGB}" Command="{Binding OpenRgb_ClickCommand}"/>
					<MenuItem Header="{x:Static resx:Strings.OpenRleImage}" Command="{Binding OpenRleImageCommand}"/>
				</MenuItem>
				<MenuItem Header="{x:Static resx:Strings.Save}" Command="{Binding Save_ClickCommand}"/>
				<MenuItem Header="{x:Static resx:Strings.SaveAs}" Command="{Binding SaveAs_ClickCommand}"/>
				<MenuItem Header="{x:Static resx:Strings.SaveAll}" Command="{Binding SaveAll_ClickCommand}"/>
				<Separator/>
				<MenuItem Header="{x:Static resx:UIStrings.Exit}" Command="{Binding Exit_ClickCommand}"/>
			</MenuItem>
			<MenuItem Header="{x:Static resx:Strings.Edit}">
				<MenuItem Header="Copy to System" Command="{Binding CopyToSystem_ClickCommand}"/>
				<Separator />
				<MenuItem Header="{x:Static resx:Strings.Transform}">
					<MenuItem Header="{x:Static resx:Strings.Rotate}" Command="{Binding RunOperationCommand}" CommandParameter="geometry.rotate-90"/>
					<MenuItem Header="{x:Static resx:Strings.Flip}" Command="{Binding RunOperationCommand}" CommandParameter="geometry.flip-180"/>
				</MenuItem>
			</MenuItem>
			<MenuItem Header="{x:Static resx:Strings.Image}">
				<MenuItem Header="{x:Static resx:Strings.Duplicate}" Command="{Binding Duplicate_CommandClick}"/>
				<MenuItem Header="{x:Static resx:Strings.Convert}">
					<MenuItem Header="{x:Static resx:Strings.Grayize}"  Command="{Binding RunOperationCommand}" CommandParameter="color.convert-grayscale"/>
					<MenuItem Header="{x:Static resx:Strings.RgbToHsv}" Command="{Binding RunOperationCommand}" CommandParameter="color.convert-hsv"/>
					<MenuItem Header="{x:Static resx:Strings.RgbToLab}" Command="{Binding RunOperationCommand}" CommandParameter="color.convert-lab"/>
				</MenuItem>
				<Separator/>
				<MenuItem Header="{x:Static resx:Strings.SplitChannels}" Command="{Binding SplitChannels_ClickCommand}"/>
				<Separator/>
				<MenuItem Header="{x:Static resx:Strings.PyramidUp}" Command="{Binding RunOperationCommand}" CommandParameter="geometry.pyramid-up"/>
				<MenuItem Header="{x:Static resx:Strings.PyramidDown}" Command="{Binding RunOperationCommand}" CommandParameter="geometry.pyramid-down"/>
			</MenuItem>
			<MenuItem Header="{x:Static resx:Strings.Process}">
				<MenuItem Header="{x:Static resx:Strings.Negate}" Command="{Binding RunOperationCommand}" CommandParameter="point.negate"/>
				<MenuItem Header="{x:Static resx:Strings.Posterize}" Command="{Binding RunOperationCommand}" CommandParameter="point.posterize"/>
				<Separator/>
				<MenuItem Header="{x:Static resx:Strings.StretchHistogram}" Command="{Binding RunOperationCommand}" CommandParameter="point.stretch-histogram"/>
				<MenuItem Header="{x:Static resx:Strings.StretchContrast}" Command="{Binding RunOperationCommand}" CommandParameter="point.stretch-contrast"/>
				<MenuItem Header="{x:Static resx:Strings.EqualizeHistogram}" Command="{Binding RunOperationCommand}" CommandParameter="point.equalize-histogram" />
				<Separator/>
				<MenuItem Header="{x:Static resx:Strings.Filters}">
					<MenuItem Header="{x:Static resx:Strings.Convolve}" Command="{Binding RunOperationCommand}" CommandParameter="filter.convolve"/>
					<MenuItem Header="{x:Static resx:Strings.Median}" Command="{Binding RunOperationCommand}" CommandParameter="filter.median"/>
					<MenuItem Header="{x:Static resx:Strings.DoubleConvolve}" Command="{Binding RunOperationCommand}" CommandParameter="filter.double-convolution"/>
				</MenuItem>
				<MenuItem Header="{x:Static resx:Strings.ImageCalculator}" Command="{Binding RunOperationCommand}" CommandParameter="calc.dialog"/>
				<Separator/>
				<MenuItem Header="{x:Static resx:Strings.Thresholding}">
					<MenuItem Header="{x:Static resx:Thresholding.OneThreshold}" Command="{Binding RunOperationCommand}" CommandParameter="threshold.simple"/>
					<MenuItem Header="{x:Static resx:Thresholding.TwoThresholds}" Command="{Binding RunOperationCommand}" CommandParameter="threshold.dual"/>
					<MenuItem Header="{x:Static resx:Thresholding.AdaptiveThresholding}" Command="{Binding RunOperationCommand}" CommandParameter="threshold.adaptive"/>
				</MenuItem>
				<MenuItem Header="{x:Static resx:Strings.MorphologicalOperations}">
					<MenuItem Header="{x:Static resx:Strings.Erode}" Command="{Binding RunOperationCommand}" CommandParameter="morph.erode"/>
					<MenuItem Header="{x:Static resx:Strings.Dilate}" Command="{Binding RunOperationCommand}" CommandParameter="morph.dilate"/>
					<MenuItem Header="{x:Static resx:Strings.MorphologicalOpen}" Command="{Binding RunOperationCommand}" CommandParameter="morph.open"/>
					<MenuItem Header="{x:Static resx:Strings.MorphologicalClose}" Command="{Binding RunOperationCommand}" CommandParameter="morph.close"/>
					<Separator/>
					<MenuItem Header="{x:Static resx:Strings.Skeletonize}" Command="{Binding RunOperationCommand}" CommandParameter="segment.skeletonize"/>
				</MenuItem>
				<MenuItem Header="{x:Static resx:Strings.EdgeDetection_Hough}" Command="{Binding RunOperationCommand}" CommandParameter="segment.hough"/>
				<Separator/>
				<MenuItem Header="{x:Static resx:Strings.Compression}">
					<MenuItem Header="{x:Static resx:Strings.RLECompression}" Command="{Binding CompressRLE_ClickCommand}"/>
				</MenuItem>
			</MenuItem>
			<MenuItem Header="{x:Static resx:Strings.Advanced}">
				<MenuItem Header="{x:Static resx:Strings.Watershed}" Command="{Binding RunOperationCommand}" CommandParameter="segment.watershed"/>
				<MenuItem Header="{x:Static resx:Strings.Inpaint}" Command="{Binding RunOperationCommand}" CommandParameter="segment.inpaint"/>
				<MenuItem Header="{x:Static resx:Strings.GrabCut}" Command="{Binding RunOperationCommand}" CommandParameter="segment.grabcut"/>
				<!--<MenuItem Header="Analyze" Command="{Binding DetailedAnalyze_ClickCommand}"/>-->
			</MenuItem>
			<MenuItem Header="{x:Static resx:Strings.Analyze}">
				<MenuItem Header="{x:Static resx:Strings.ShowHistogram}" Command="{Binding ShowHistogram_ClickCommand}"/>
				<MenuItem Header="{x:Static resx:Strings.PlotProfile}" Command="{Binding PlotProfile_ClickCommand}"/>
				<Separator/>
			<MenuItem x:Name="RecipesMenu" Header="Recipes">
				<MenuItem Header="Start recording" Command="{Binding StartRecordingCommand}"/>
				<MenuItem Header="Stop recording" Command="{Binding StopRecordingCommand}"/>
				<Separator/>
				<MenuItem Header="Recipes..." Command="{Binding OpenManagerCommand}"/>
			</MenuItem>
			<MenuItem Header="{x:Static resx:Strings.Analyze}">
					<MenuItem Header="{x:Static resx:Thresholding.SimpleAnalyze}" Command="{Binding SimpleAnalyze_ClickCommand}"/>
					<MenuItem Header="{x:Static resx:Thresholding.Analyze}" Command="{Binding Analyze_ClickCommand}"/>
				</MenuItem>
			</MenuItem>
			<MenuItem Header="{x:Static resx:UIStrings.Settings}" Command="{Binding OpenSettings_ClickCommand}"/>
			<MenuItem Header="{x:Static resx:UIStrings.Help}">
				<MenuItem Header="{x:Static resx:UIStrings.About}" Click="About_Click"/>
			</MenuItem>
		</Menu>
		<Label x:Name="LblFocusedImage" Content="{Binding LblFocusedImageContent, TargetNullValue=null}" Grid.Row="1" HorizontalAlignment="Left" Margin="0,2,0,0" VerticalAlignment="Top" Height="31" Width="Auto"/>
		<ToolBar HorizontalAlignment="Stretch" Height="36" VerticalAlignment="Top" Width="Auto" Grid.Row="2" ToolBarTray.IsLocked="True">
			<RadioButton Tag="None" GroupName="ToolGroup" Checked="RadioButton_Checked" Unchecked="RadioButton_Unchecked">
				<RadioButton.Background>
					<ImageBrush ImageSource="/Resources/Icons/ToolBar_Icons/NoneIcon.ico"/>
				</RadioButton.Background>
				<Grid>
					<Image Width="16" Height="16"/>
				</Grid>
			</RadioButton>
			<RadioButton Tag="ProfileLine" GroupName="ToolGroup" Checked="RadioButton_Checked" Unchecked="RadioButton_Unchecked">
				<RadioButton.Background>
					<ImageBrush ImageSource="/Resources/Icons/ToolBar_Icons/LineSegment.ico"/>
				</RadioButton.Background>
				<Grid>
					<Image Width="16" Height="16"/>
				</Grid>
			</RadioButton>
			<RadioButton Tag="Rectangle" GroupName="ToolGroup" Checked="RadioButton_Checked" Unchecked="RadioButton_Unchecked">
				<RadioButton.Background>
					<ImageBrush ImageSource="/Resources/Icons/ToolBar_Icons/DrawRectangle.ico"/>
				</RadioButton.Background>
				<Grid>
					<Image Width="16" Height="16"/>
				</Grid>
			</RadioButton>
			<Separator/>
			<RadioButton Checked="RadioButtonClear_Checked" Unchecked="RadioButton_Unchecked">
				<RadioButton.Background>
					<ImageBrush ImageSource="/Resources/Icons/ToolBar_Icons/ClearCanvas.ico"/>
				</RadioButton.Background>
				<Grid>
					<Image Width="16" Height="16"/>
				</Grid>
			</RadioButton>
		</ToolBar>
		<StackPanel Orientation="Horizontal" Grid.Row="3">
			<TextBlock Text="{Binding Descriptor}"/>
			<TextBlock Text="{Binding RecordingStatus}" Foreground="DarkRed" Margin="16,0,0,0"/>
		</StackPanel>

		<Grid Grid.RowSpan="5" Background="#66000000"
			  Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"
			  Panel.ZIndex="100">
			<Border Background="#FAFAFA" BorderBrush="#DDDDDD" BorderThickness="1"
					CornerRadius="8" Padding="28,20" Width="260"
					HorizontalAlignment="Center" VerticalAlignment="Center">
				<StackPanel>
					<TextBlock Text="{Binding IsBusyStatus}" FontSize="14" FontWeight="SemiBold"
							   Foreground="#1F1F1F" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"
							   ToolTip="{Binding IsBusyStatus}"/>
					<ProgressBar IsIndeterminate="True" Height="4" MinWidth="200" Margin="0,14,0,0"
								 Foreground="#2B6CB0" Background="#E2E8F0" BorderThickness="0"/>
					<Button Content="Cancel" Command="{Binding CancelOperationCommand}"
							Width="96" Height="30" Margin="0,16,0,0" HorizontalAlignment="Center"
							IsCancel="True"/>
				</StackPanel>
			</Border>
		</Grid>

	</Grid>
</Window>
