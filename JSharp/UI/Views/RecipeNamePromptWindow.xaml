<Window x:Class="JSharp.UI.Views.RecipeNamePromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:JSharp.ViewModels"
        d:DataContext="{d:DesignInstance Type=viewModels:RecipeNamePromptWindowViewModel}"
        mc:Ignorable="d"
        Title="Name recipe" Height="170" Width="360" WindowStartupLocation="CenterOwner">
	<StackPanel Margin="16">
		<TextBlock Text="Recipe name:"/>
		<TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,0"/>
		<TextBlock Text="{Binding Error}" Foreground="Red" Margin="0,4,0,0" Height="20"/>
		<StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
			<Button Content="OK" Command="{Binding OkCommand}" Width="80" Margin="0,0,8,0" IsDefault="True"/>
			<Button Content="Cancel" Command="{Binding CancelCommand}" Width="80" IsCancel="True"/>
		</StackPanel>
	</StackPanel>
</Window>
