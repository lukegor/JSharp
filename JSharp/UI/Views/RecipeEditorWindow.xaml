<Window x:Class="JSharp.UI.Views.RecipeEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:JSharp.ViewModels"
        d:DataContext="{d:DesignInstance Type=viewModels:RecipeEditorWindowViewModel}"
        mc:Ignorable="d"
        Title="{Binding RecipeName}" Height="480" Width="640">
	<Grid Margin="12">
		<Grid.RowDefinitions>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<ListBox Grid.Row="0" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}">
			<ListBox.ItemTemplate>
				<DataTemplate>
					<StackPanel Orientation="Horizontal" Margin="0,2">
						<CheckBox IsChecked="{Binding Enabled, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,8,0"/>
						<TextBlock Text="{Binding Step.DisplayName}" Width="220" VerticalAlignment="Center"/>
						<TextBlock Text="{Binding ParamsSummary}" Width="220" VerticalAlignment="Center" Opacity="0.7"/>
						<Button Content="Up" Command="{Binding DataContext.MoveUpCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" Margin="4,0"/>
						<Button Content="Down" Command="{Binding DataContext.MoveDownCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" Margin="4,0"/>
						<Button Content="Delete" Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" Margin="4,0"/>
					</StackPanel>
				</DataTemplate>
			</ListBox.ItemTemplate>
		</ListBox>

		<GroupBox Grid.Row="1" Header="Selected step" Margin="0,8,0,0">
			<StackPanel>
				<ItemsControl ItemsSource="{Binding SelectedRow.Fields}">
					<ItemsControl.ItemTemplate>
						<DataTemplate>
							<StackPanel Orientation="Horizontal" Margin="0,2">
								<TextBlock Text="{Binding Label}" Width="100" VerticalAlignment="Center"/>
								<TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" Width="120"/>
								<TextBlock Text="{Binding Error}" Foreground="Red" Margin="8,0,0,0" VerticalAlignment="Center"/>
							</StackPanel>
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>
				<StackPanel Orientation="Horizontal" Margin="0,6,0,0">
					<Button Content="Apply values" Command="{Binding ApplyFieldsCommand}" CommandParameter="{Binding SelectedRow}" Margin="0,0,8,0"/>
					<Button Content="Rebind aux image..." Command="{Binding RebindAuxCommand}" CommandParameter="{Binding SelectedRow}"/>
				</StackPanel>
			</StackPanel>
		</GroupBox>

		<StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
			<Button Content="Save" Command="{Binding SaveCommand}" Width="100" IsDefault="True"/>
		</StackPanel>
	</Grid>
</Window>
